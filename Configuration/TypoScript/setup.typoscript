plugin.tx_events {
    view {
        # Fallback templates; the CE extension (EXT:events_ces) overrides at .20.
        templateRootPaths.10 = EXT:events/Resources/Private/Templates/
        partialRootPaths.10 = EXT:events/Resources/Private/Partials/
        layoutRootPaths.10 = EXT:events/Resources/Private/Layouts/

        # All plugins share one namespace; the controller is picked via events[controller].
        pluginNamespace = events
    }

    settings {
        dataProcessing {
            WerkraumMedia\Events\Domain\Model\Event {
                10 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
                10 {
                    special = list
                    special.value.field = pages
                    dataProcessing {
                        10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
                        10 {
                            references.fieldName = media
                        }
                    }
                }
            }
        }
    }
}
